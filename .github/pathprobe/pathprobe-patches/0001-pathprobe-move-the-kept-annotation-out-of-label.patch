diff --git a/expected/pathprobe_kept.out b/expected/pathprobe_kept.out
new file mode 100644
index 0000000..6f0bc68
--- /dev/null
+++ b/expected/pathprobe_kept.out
@@ -0,0 +1,42 @@
+-- survivor annotations in pathprobe JSON: "kept" is a field of its own;
+-- "label" (and origin "proposed") stays with proposed paths
+SET client_min_messages = warning;
+CREATE EXTENSION IF NOT EXISTS pathprobe;
+RESET client_min_messages;
+SET max_parallel_workers_per_gather = 0;
+CREATE TABLE kp_t (id int, v int);
+INSERT INTO kp_t SELECT g, g % 100 FROM generate_series(1, 2000) g;
+CREATE INDEX kp_t_id ON kp_t (id);
+CREATE INDEX kp_t_v ON kp_t (v);
+ANALYZE kp_t;
+CREATE TABLE kp_p (id int, v int);
+INSERT INTO kp_p SELECT g, g % 100 FROM generate_series(1, 2200) g;
+ANALYZE kp_p;
+-- 1. range + order keeps a non-cheapest survivor (the pathprobe.sql case);
+-- an annotated survivor is a real path and carries no label
+WITH j AS (SELECT pathprobe_json('SELECT * FROM kp_t WHERE v BETWEEN 5 AND 8 ORDER BY v')::jsonb AS j),
+     e AS (SELECT e FROM j, jsonb_array_elements(j->'events') e)
+SELECT (SELECT count(*) > 0 FROM e WHERE e->>'kept' IN ('startup', 'order?')) AS has_kept,
+       (SELECT bool_and(e->>'origin' = 'real' AND NOT e ? 'label') FROM e WHERE e ? 'kept')
+         AS kept_are_real,
+       (SELECT bool_and(e->>'kind' = 'survived') FROM e WHERE e ? 'kept') AS kept_are_survivors,
+       (SELECT bool_and(e->>'origin' = 'real') FROM e) AS no_proposed;
+ has_kept | kept_are_real | kept_are_survivors | no_proposed 
+----------+---------------+--------------------+-------------
+ t        | t             | t                  | t
+(1 row)
+
+-- 2. the labelled events of a proposed candidate are still "proposed"
+WITH j AS (SELECT pathprobe_propose_json(
+             $$ SELECT * FROM kp_p WHERE id = 42 $$,
+             '{"target":{"relname":"kp_p"},"candidate":{"pathname":"c_kept","provider":"t"},"cost":{"total_cost":0.5},"mode":{"winner_forbidden":true}}')::jsonb AS j),
+     e AS (SELECT e FROM j, jsonb_array_elements(j->'events') e)
+SELECT (SELECT count(*) > 0 FROM e WHERE e->>'label' = 'c_kept') AS has_label,
+       (SELECT bool_and(e->>'origin' = 'proposed' AND NOT e ? 'kept') FROM e WHERE e ? 'label')
+         AS labelled_are_proposed;
+ has_label | labelled_are_proposed 
+-----------+-----------------------
+ t         | t
+(1 row)
+
+DROP TABLE kp_t, kp_p;
