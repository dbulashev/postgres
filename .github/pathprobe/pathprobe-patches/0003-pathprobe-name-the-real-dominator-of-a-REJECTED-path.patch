+-- 8. a REJECTED event names the path it lost to: one accepted into the
+-- same rel before, never the rejected path itself, of the type it reports
+SELECT
+  (SELECT (j->'coverage'->>'add_path_rejected_dominator')::bool FROM gr_j) AS covered,
+  (SELECT count(*) > 0 FROM gr_ev WHERE kind = 'rejected') AS has_rejected,
+  (SELECT bool_and(EXISTS (SELECT 1 FROM gr_ev a WHERE a.kind = 'accepted'
+                           AND a.path_id = r.dominator_path_id
+                           AND a.rel = r.rel AND a.seq < r.seq))
+   FROM gr_ev r WHERE r.kind = 'rejected')
+    AS dominator_accepted_before,
+  (SELECT bool_and(dominator_path_id <> path_id) FROM gr_ev WHERE kind = 'rejected')
+    AS dominator_is_another_path,
+  (SELECT bool_and(d.pathtype = r.other_pathtype)
+   FROM gr_ev r JOIN gr_paths d ON d.path_id = r.dominator_path_id
+   WHERE r.kind = 'rejected')
+    AS other_pathtype_is_dominators;
+ covered | has_rejected | dominator_accepted_before | dominator_is_another_path | other_pathtype_is_dominators 
+---------+--------------+---------------------------+---------------------------+------------------------------
+ t       | t            | t                         | t                         | t
+(1 row)
+
 DROP TABLE gr_o, gr_c;
