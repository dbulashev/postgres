 RESET pathprobe.log_accepted;
+-- 6. path properties: the index of an index path, required_outer of a
+-- parameterized one, rows on every node, startup cost on every event
+SELECT
+  (SELECT bool_and(index IN (SELECT indexrelid::regclass::text FROM pg_index
+                             WHERE indrelid = 'gr_o'::regclass))
+          AND bool_or(index = 'gr_o_customer_idx')
+   FROM gr_paths
+   WHERE rel = '{2}' AND pathtype IN ('IndexScan', 'IndexOnlyScan', 'BitmapHeapScan'))
+    AS inner_index_named,
+  (SELECT bool_and(index IS NOT NULL AND index_oid::regclass::text = index)
+   FROM gr_paths WHERE pathtype IN ('IndexScan', 'IndexOnlyScan'))
+    AS index_paths_have_index,
+  (SELECT bool_and(index IS NULL AND index_oid IS NULL)
+   FROM gr_paths WHERE pathtype NOT IN ('IndexScan', 'IndexOnlyScan', 'BitmapHeapScan'))
+    AS others_have_none,
+  (SELECT bool_and((rel = '{1}' AND required_outer = '{2}') OR
+                   (rel = '{2}' AND required_outer = '{1}'))
+          AND bool_or(rel = '{2}')
+   FROM gr_paths WHERE required_outer IS NOT NULL)
+    AS required_outer_is_other_rel,
+  (SELECT bool_and(e.param = (p.required_outer IS NOT NULL))
+   FROM gr_ev e JOIN gr_paths p USING (path_id))
+    AS param_matches_required_outer,
+  (SELECT bool_and(rows > 0) FROM gr_paths) AS rows_positive,
+  (SELECT bool_and(cost_startup IS NOT NULL AND cost_startup <= cost_total) FROM gr_ev)
+    AS startup_le_total;
+ inner_index_named | index_paths_have_index | others_have_none | required_outer_is_other_rel | param_matches_required_outer | rows_positive | startup_le_total 
+-------------------+------------------------+------------------+-----------------------------+------------------------------+---------------+------------------
+ t                 | t                      | t                | t                           | t                            | t             | t
+(1 row)
+
+-- 7. a path over a hypothetical index names no index: its fake oid has no
+-- catalog entry; the hypo: label of its events identifies it
+WITH j AS (SELECT pathprobe_propose_json('SELECT * FROM gr_o WHERE amount = 5',
+             '{"hypo_indexes":[{"relname":"gr_o","columns":["amount"],"name":"gr_hypo"}]}')::jsonb AS j),
+     p AS (SELECT p FROM j, jsonb_array_elements(j->'paths') p
+           WHERE (p->>'index_hypothetical')::bool),
+     e AS (SELECT e FROM j, jsonb_array_elements(j->'events') e)
+SELECT (SELECT count(*) > 0 FROM p) AS has_hypo_path,
+       (SELECT bool_and(NOT p.p ? 'index_oid' AND NOT p.p ? 'index') FROM p) AS no_oid_no_name,
+       (SELECT bool_or(e.e->>'label' = 'hypo:gr_hypo')
+        FROM e JOIN p ON e.e->'path_id' = p.p->'path_id') AS labelled;
+ has_hypo_path | no_oid_no_name | labelled 
+---------------+----------------+----------
+ t             | t              | t
+(1 row)
+
 DROP TABLE gr_o, gr_c;
diff --git a/pathprobe.c b/pathprobe.c
index 85ba445..5fb9a0d 100644
