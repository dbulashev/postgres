+/*
+ * the index an index path scans: IndexScan and IndexOnlyScan, or a
+ * BitmapHeapScan over a single index; NULL for BitmapAnd / BitmapOr (several
+ * indexes) and other paths
+ */
+static const IndexOptInfo *
+path_index(const Path *path)
+{
+	if (path == NULL)
+		return NULL;
+	if (IsA(path, IndexPath))
+		return ((const IndexPath *) path)->indexinfo;
+	if (IsA(path, BitmapHeapPath))
+		return path_index(((const BitmapHeapPath *) path)->bitmapqual);
+	return NULL;
+}
+
 static int
 pelog_register_path(PathEventLog *log, Path *path)
 {
@@ -448,6 +465,7 @@ pelog_register_path(PathEventLog *log, Path *path)
 				outer = 0,
 				inner = 0;
 	Path	   *child;
+	const IndexOptInfo *index;
 
 	if (path == NULL)
 		return 0;
@@ -500,6 +518,12 @@ pelog_register_path(PathEventLog *log, Path *path)
 	log->nodes[idx].subpath_id = sub;
 	log->nodes[idx].outer_path_id = outer;
 	log->nodes[idx].inner_path_id = inner;
+	log->nodes[idx].rows = path->rows;
+	log->nodes[idx].required_outer =
+		pelog_intern_relids(log, PATH_REQ_OUTER(path));
+	index = path_index(path);
+	log->nodes[idx].index_oid = index ? index->indexoid : InvalidOid;
+	log->nodes[idx].index_hypothetical = index ? index->hypothetical : false;
 	return id;
 }
 
